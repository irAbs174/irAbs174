[Unit]
Description=damerchi.ir gunicorn
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/damerchi.ir
EnvironmentFile=/var/www/damerchi.ir/.env
ExecStart=/var/www/damerchi.ir/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8001 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
